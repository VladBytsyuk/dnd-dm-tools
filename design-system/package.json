{
	"name": "@dnd-dm-tools/design-system",
	"version": "0.1.0",
	"description": "Private Svelte design system for DnD DM Tools.",
	"private": true,
	"type": "module",
	"license": "MIT",
	"engines": {
		"node": ">=20.19.0"
	},
	"files": [
		"dist"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"default": "./dist/index.js"
		}
	},
	"scripts": {
		"check:boundaries": "node scripts/check-boundaries.mjs",
		"check:svelte": "svelte-check --tsconfig ./tsconfig.json",
		"check": "npm run check:boundaries && npm run check:svelte",
		"build": "svelte-package",
		"storybook": "storybook dev -p 6006",
		"storybook:build": "storybook build -o storybook-static",
		"validate": "npm run check && npm run build && npm run storybook:build"
	},
	"peerDependencies": {
		"svelte": "^5.38.1"
	},
	"devDependencies": {
		"@storybook/addon-docs": "^10.6.0",
		"@storybook/svelte-vite": "^10.6.0",
		"@sveltejs/package": "^2.5.8",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"storybook": "^10.6.0",
		"svelte": "^5.57.0",
		"svelte-check": "^4.7.6",
		"typescript": "^5.9.3",
		"vite": "^7.3.6"
	}
}
